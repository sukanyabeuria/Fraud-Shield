# ============================================================================
#  Fraud-Shield — FRONTEND environment variables
#  Copy to `.env` (or `.env.local`) and adjust:  cp .env.example .env
# ============================================================================
#
#  ⚠ SECURITY
#  Vite inlines every VITE_* variable into the JavaScript bundle that is sent
#  to the browser. NEVER put database credentials, JWT secrets or API keys
#  here. PostgreSQL is reached ONLY by the FastAPI backend:
#
#      React frontend  →  FastAPI backend  →  ML model  →  PostgreSQL
#
# ----------------------------------------------------------------------------

# Base URL of the FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Request timeout in milliseconds. Raise it if the first ML inference is slow
# (model cold start / SHAP explainer warm-up).
VITE_API_TIMEOUT_MS=30000
