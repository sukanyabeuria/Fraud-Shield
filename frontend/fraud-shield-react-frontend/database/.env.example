# ============================================================================
#  FRAUD-SHIELD — DATABASE ENVIRONMENT TEMPLATE
#  Copy to `.env` (which MUST be git-ignored) and fill in real values.
#      cp database/.env.example .env
#  NEVER commit real credentials. NEVER hard-code them in source files.
# ============================================================================

# ---------------------------------------------------------------------------
# Connection (individual parts — preferred, works with node-pg defaults)
# ---------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=fraudshield
PGUSER=fraudshield_app
PGPASSWORD=change_me_in_your_secret_manager
PGSCHEMA=fraudshield

# ---------------------------------------------------------------------------
# Connection string (alternative — some hosts give you only this)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://fraudshield_app:change_me@localhost:5432/fraudshield

# ---------------------------------------------------------------------------
# TLS — set to `require` (or `verify-full` with a CA) for any hosted database
# ---------------------------------------------------------------------------
PGSSLMODE=disable
# PGSSLROOTCERT=/etc/ssl/certs/rds-ca.pem

# ---------------------------------------------------------------------------
# Pool tuning
# ---------------------------------------------------------------------------
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Extra role credentials (used by the ML service and BI tools, not the API)
# ---------------------------------------------------------------------------
DB_ML_USER=fraudshield_ml
DB_ML_PASSWORD=change_me
DB_READONLY_USER=fraudshield_readonly
DB_READONLY_PASSWORD=change_me

# ---------------------------------------------------------------------------
# Application secrets that live next to the DB config
# ---------------------------------------------------------------------------
JWT_SECRET=generate_with_openssl_rand_base64_48
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Downstream services (for later)
# ---------------------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8001
XAI_SERVICE_URL=http://localhost:8002
